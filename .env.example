PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dut_job_fair
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_REFRESH_EXPIRES_IN=7d

# Set the same two values in local .env and in the production seed job.
# These are passwords for the seeded accounts; do not commit real values.
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_BUSINESS_PASSWORD=replace-with-a-strong-business-password
